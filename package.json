{
  "name": "natively",
  "version": "2.5.0",
  "main": "dist-electron/electron/main.js",
  "description": "Natively is a meeting notes app that uses AI to generate notes from your meetings.",
  "scripts": {
    "clean": "rimraf dist dist-electron",
    "dev": "vite",
    "build": "npm run clean && tsc && vite build",
    "build:electron": "node scripts/build-electron.js",
    "build:electron:tsc": "tsc -p electron/tsconfig.json",
    "typecheck:electron": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "postinstall": "patch-package && cross-env SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm rebuild sharp && node scripts/download-models.js && node scripts/ensure-sqlite-vec.js && node scripts/patch-electron-plist.js && node scripts/verify-native-arch.js",
    "rebuild:native": "npm rebuild better-sqlite3 keytar && node scripts/verify-native-arch.js",
    "electron:dev": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build:electron && cross-env NODE_ENV=production electron .",
    "app:dev": "concurrently \"npm run dev -- --port 5180 --strictPort\" \"wait-on http://localhost:5180 && npm run electron:dev\"",
    "app:build": "npm run build && npm run build:electron && cross-env NATIVELY_BUILD_ALL_MAC_ARCHES=1 npm run build:native && npm run build:parakeet-helper && electron-builder",
    "app:build:mac-arm64": "npm run build && npm run build:electron && npm run build:native && npm run build:parakeet-helper && electron-builder --mac zip --arm64 --publish never -c.mac.target=zip",
    "app:install:local": "npm run build && npm run build:electron && npm run build:native && npm run build:parakeet-helper && electron-builder --mac dir --arm64 && (osascript -e 'tell application \"Natively\" to quit' || true) && rm -rf /Applications/Natively.app && cp -R release/mac-arm64/Natively.app /Applications/ && npm run app:verify:local -- --leave-running",
    "app:verify:local": "node scripts/check-macos-app-runtime.js",
    "app:launch:audio-debug": "node scripts/launch-local-app.js --audio-debug",
    "app:launch:normal": "node scripts/launch-local-app.js --normal",
    "meeting:replay": "node scripts/replay-meeting.js",
    "meeting:replay:audio": "node scripts/replay-audio.js",
    "meeting:focus:debug": "node scripts/replay-action-focus.js",
    "meeting:conference:guard": "node scripts/check-conference-mode.js",
    "meeting:conference:memory:guard": "node scripts/check-semantic-conference-memory.js",
    "window:visibility:guard": "node scripts/check-window-visibility-policy.js",
    "meeting:layout:guard": "node scripts/check-overlay-layout.js",
    "meeting:layout:stress": "node scripts/check-overlay-stress-budget.js",
    "meeting:layout:dom": "node scripts/check-overlay-dom-stress.js",
    "meeting:model-selector:guard": "node scripts/check-model-selector-visibility.js",
    "codex:gpt56:guard": "node scripts/check-codex-gpt56-integration.js",
    "codex:gpt56:smoke": "node scripts/smoke-codex-gpt56-runtime.js",
    "codex:transport:test": "node scripts/check-codex-responses-transport.js",
    "meeting:action:guard": "node scripts/check-meeting-action-reliability.js",
    "meeting:action:idempotency:test": "node scripts/check-live-action-idempotency.js",
    "meeting:action:errors:test": "node scripts/check-live-action-errors.js",
    "meeting:action:installed:e2e": "node scripts/check-installed-live-action-e2e.js",
    "meeting:conference:installed:e2e": "node scripts/check-installed-conference-e2e.js",
    "meeting:runtime:guard": "node scripts/check-meeting-runtime-quality.js",
    "meeting:separation:guard": "node scripts/check-meeting-speaker-separation.js",
    "meeting:separation:watch": "node scripts/watch-meeting-speaker-separation.js",
    "meeting:separation:live": "node scripts/watch-meeting-speaker-separation.js --require-me",
    "meeting:separation:live:strict": "node scripts/watch-meeting-speaker-separation.js --require-me --fail-on-suspect-me",
    "meeting:summary:guard": "node scripts/check-meeting-summary-quality.js",
    "meeting:summary:guard:selftest": "node scripts/check-meeting-summary-quality.js --self-test",
    "meeting:persistence:guard": "node scripts/check-meeting-persistence-reliability.js",
    "meeting:summary:normalization:test": "node scripts/check-meeting-summary-normalization.js",
    "meeting:summary:repair-titles": "node scripts/repair-duplicated-meeting-titles.js",
    "meeting:repair:db": "node scripts/check-meeting-repair-against-db.js",
    "meeting:repair:live": "node scripts/check-meeting-repair-against-db.js --require-post-install",
    "meeting:echo-gate:guard": "node scripts/check-audio-echo-gate.js",
    "meeting:parakeet:diarization:guard": "node scripts/check-parakeet-live-diarization.js",
    "watch": "tsc -p electron/tsconfig.json --watch",
    "start": "npm run app:dev",
    "dist": "npm run app:build",
    "build:native": "node scripts/build-native.js",
    "build:parakeet-helper": "node scripts/build-parakeet-helper.js"
  },
  "build": {
    "generateUpdatesFilesForAllChannels": true,
    "appId": "com.electron.meeting-notes",
    "afterPack": "./scripts/ad-hoc-sign.js",
    "productName": "Natively",
    "files": [
      "dist",
      "dist-electron",
      "native-module",
      "package.json",
      "node_modules",
      "!**/native-module/target",
      "!**/native-module/src",
      "!**/native-module/.cargo"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/*.dylib",
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/keytar/**",
      "**/node_modules/sqlite-vec/**",
      "**/node_modules/sqlite-vec-*/**",
      "**/node_modules/sharp/**",
      "**/node_modules/detect-libc/**",
      "**/node_modules/semver/**",
      "**/node_modules/@img/**",
      "**/node_modules/@napi-rs/**",
      "**/node_modules/@xenova/transformers/**",
      "**/node_modules/@huggingface/jinja/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-web/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/"
      },
      {
        "from": "assets/natively.icns",
        "to": "natively.icns"
      },
      {
        "from": "resources/models/",
        "to": "models/"
      },
      {
        "from": "native-helpers/parakeet-stt-helper/dist/parakeet-stt-helper",
        "to": "helpers/parakeet-stt-helper"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/natively.icns",
      "identity": null,
      "hardenedRuntime": true,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Natively needs Screen Recording permission to capture system audio for meeting transcription.",
        "NSAudioCaptureUsageDescription": "Natively needs system audio capture access to transcribe other speakers during meetings.",
        "NSMicrophoneUsageDescription": "Natively needs microphone access to transcribe your voice during meetings."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/win/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/png/",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Natively-AI-assistant",
        "repo": "natively-cluely-ai-assistant",
        "releaseType": "release"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.0.3",
    "@napi-rs/cli": "^3.5.1",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/color": "^4.2.0",
    "@types/diff": "^6.0.0",
    "@types/electron": "^1.4.38",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/screenshot-desktop": "^1.12.3",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "patch-package": "^8.0.0",
    "dotenv": "^17.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.49",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@bany/curl-to-json": "^1.2.10",
    "@deepgram/sdk": "^3.13.0",
    "@elevenlabs/client": "^0.15.1",
    "@elevenlabs/elevenlabs-js": "^2.39.0",
    "@google-cloud/speech": "^7.2.1",
    "@google/genai": "^1.44.0",
    "@google/stitch-sdk": "^0.0.3",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.2",
    "@tavily/core": "^0.7.2",
    "@types/keytar": "^4.4.0",
    "@types/three": "^0.182.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.7.7",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "diff": "^7.0.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "form-data": "^4.0.1",
    "framer-motion": "^12.29.2",
    "groq-sdk": "^0.37.0",
    "jspdf": "^4.0.0",
    "katex": "^0.16.27",
    "keytar": "^7.9.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.11.0",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-markdown": "^10.1.0",
    "react-query": "^3.39.3",
    "react-syntax-highlighter": "^15.6.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "sqlite-vec": "^0.1.7-alpha.2",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^2.5.4",
    "tap": "^21.5.0",
    "tesseract.js": "^5.0.5",
    "three": "^0.182.0",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.3",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "^0.1.7-alpha.2",
    "sqlite-vec-darwin-x64": "^0.1.7-alpha.2"
  }
}
